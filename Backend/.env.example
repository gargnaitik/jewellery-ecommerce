# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Frontend origin(s) allowed by CORS — comma-separate several
CLIENT_URL=http://localhost:5173
# Used to build links in emails (verify email, shop now)
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL (users, orders, payments) ─────────────
# Local (matches docker-compose.yml):
PG_HOST=localhost
PG_PORT=5432
PG_DB=jewellery_db
PG_USER=postgres
PG_PASSWORD=yourpassword
# Hosted (Neon / Supabase / Render) — takes precedence over PG_* when set:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# PG_SSL=false   # only if your hosted DB doesn't use SSL
# Allow sequelize.sync({ alter: true }) in production (off by default)
# DB_SYNC_ALTER=false

# ─── MongoDB (product catalogue) ──────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/jewellery-ecommerce

# ─── Redis (cache, OTPs, rate limits, token blacklist) ─
# Upstash uses rediss://default:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Gold rates (goldapi.io) ──────────────────────────
GOLD_API_KEY=your_goldapi_key
# How long a fetched rate is cached and how often product prices are
# recomputed. Free goldapi plan is ~100 requests/month -> use 21600 (6h)
GOLD_RATE_TTL_SECONDS=900

# ─── Razorpay (use test keys) ─────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── Cloudinary (product images) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email ────────────────────────────────────────────
EMAIL_FROM="Kanakam Fine Jewellery <your_email@gmail.com>"
# Option A — Brevo HTTP API (works where SMTP ports are blocked, e.g. Render free tier)
# BREVO_API_KEY=your_brevo_api_key
# Option B — SMTP (Gmail needs an app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ─── SMS via MSG91 (optional — in development OTPs are logged instead) ─
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# ─── Seeding product images (optional, seed-images.js) ─
UNSPLASH_ACCESS_KEY=
